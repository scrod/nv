    {
      "id": "receive",
      "title": "Repository → accepted history",
      "short": "Receive",
      "description": "Discovery supplies candidates. Retention, prerequisites, validation and acceptance establish local history independently of arrival order.",
      "stages": [
        {
          "title": "Discover and read candidates",
          "nodes": [
            "rkeys",
            "rchanges",
            "rinitial",
            "rgeneral",
            "recvwork",
            "rootowner"
          ],
          "detail": "Rooted bounded discovery and exact reads capture candidate bytes."
        },
        {
          "title": "Retain before accepting",
          "nodes": [
            "objects",
            "receiveq"
          ],
          "detail": "Durable candidate bytes and ready / wait / reject obligations survive restart."
        },
        {
          "title": "Check the complete unit",
          "nodes": [
            "decoded",
            "graph",
            "snapwork",
            "batch"
          ],
          "detail": "Resolve requirements and verify protections, graph roles and complete semantic units."
        },
        {
          "title": "Accept and publish locally",
          "nodes": [
            "accepted",
            "pin",
            "reduce",
            "live"
          ],
          "detail": "Atomically accept history, advance the pin and generation-fence model publication."
        }
      ],
