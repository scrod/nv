      ]
    },
    {
      "id": "publish",
      "title": "Accepted bytes → repository",
      "short": "Publish",
      "description": "Copy exact locally durable objects into the repository through owned temporary files. Verify the final installation and complete the required durability steps.",
      "stages": [
