  "traces": [
    {
      "id": "save",
      "title": "Edit → local durability",
      "short": "Edit / save",
      "description": "Immediate edits become captured, sealed and validated input. Acceptance retains complete groups and required closure in one private transaction.",
      "stages": [
        {
          "title": "Admit the edit",
          "nodes": [
            "live",
            "pendinglive"
          ],
          "detail": "The live collection accepts input immediately; exact generations track pending work."
        },
        {
          "title": "Freeze and seal once",
          "nodes": [
            "capture",
            "seal"
          ],
          "detail": "Capture complete meaningful actions and produce exact retryable immutable bytes."
        },
        {
          "title": "Establish semantic agreement",
          "nodes": [
            "decoded",
            "graph",
            "batch"
          ],
          "detail": "Use the permitted checked-current basis or full declared-history validation."
        },
        {
          "title": "Commit locally",
          "nodes": [
            "objects",
            "accepted",
            "pin",
            "opindex",
            "actionindex"
          ],
          "detail": "Retain bytes, accepted membership, indexes and required closure atomically; acknowledge covered generations."
        }
      ],
      "edges": [
        "e1",
        "e2",
        "e3",
        "e4",
        "e5",
        "e6",
        "e7",
        "e8",
        "e9",
        "e10",
        "e11",
        "e12",
        "e13",
        "e16"
      ]
    },
    {
      "id": "reopen",
      "title": "Private current rows → live model",
      "short": "Reopen",
      "description": "Open the owned keyed store, drain startup-required work and catch up any indexed accepted suffix. A consistent complete current-row/context read supplies the live model. Invalid materialization or unfinished verification follows its separate required reconstruction/check path.",
      "stages": [
        {
          "title": "Unlock and bind the store",
          "nodes": [
            "unlock",
            "keychain",
            "secrets",
            "dbcontainer",
            "header",
            "localowner"
          ],
          "detail": "Recover a usable key, open the keyed container and validate selected store / bootstrap scope."
        },
        {
          "title": "Drain required work / catch up the suffix",
          "nodes": [
            "receiveq",
            "recvwork",
            "accepted",
            "verification",
            "reduce"
          ],
          "detail": "Drain required Changes and prerequisites, replay unfinished verification, and bring lagging materialization to the accepted prefix. Independent optional snapshots stay queued until publication. Healthy settled startup reads no old history envelopes."
        },
        {
          "title": "Capture complete current rows and context",
          "nodes": [
            "current",
            "view",
            "dict"
          ],
          "detail": "One consistent read captures all current bodies, compact authoring context, view epoch and represented prefix. Invalid rows or named codec data require exceptional reconstruction from retained history."
        },
        {
          "title": "Publish the app model",
          "nodes": [
            "live",
            "search",
            "gate"
          ],
          "detail": "Construct all notes/search state, then recheck owner, lifecycle, view epoch and accepted/materialized prefixes before atomic host publication. Search remains synchronous."
        }
      ],
      "edges": [
        "e91",
        "e92",
        "e97",
