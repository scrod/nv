  "traces": [
    {
      "id": "save",
      "title": "Edit → local durability",
      "short": "Edit / save",
      "description": "Edits appear immediately, then complete actions are frozen, encoded and checked. One private transaction saves the exact history and every required related record.",
      "stages": [
        {
          "title": "Admit the edit",
          "nodes": [
            "live",
            "pendinglive"
          ],
          "detail": "The live note store changes immediately; a local version identifies each pending edit."
        },
        {
          "title": "Freeze and encode once",
          "nodes": [
            "capture",
            "seal"
          ],
          "detail": "Capture the complete action and fix the exact bytes that saving and retry will use."
        },
        {
          "title": "Check history consistency",
          "nodes": [
            "decoded",
            "graph",
            "batch"
          ],
          "detail": "Validate against a checked current-state basis or the complete declared history."
        },
        {
          "title": "Commit locally",
          "nodes": [
            "objects",
            "accepted",
            "pin",
            "opindex",
            "actionindex"
          ],
          "detail": "Save exact bytes, accepted membership, indexes and all required history together; acknowledge only the captured edit versions."
        }
      ],
      "edges": [
        "e1",
        "e2",
        "e3",
        "e4",
        "e5",
        "e6",
        "e7",
        "e8",
        "e9",
        "e10",
        "e11",
        "e12",
        "e13",
        "e16"
      ]
    },
    {
      "id": "reopen",
      "title": "Private current rows → live model",
      "short": "Reopen",
      "description": "Open and unlock the owned private store, finish required receive/check work, and bring current rows through any new accepted history. Read all current values and editing context together. Invalid rows or unfinished verification take their required rebuild/check path.",
      "stages": [
        {
          "title": "Unlock and check the selected store",
          "nodes": [
            "unlock",
            "keychain",
            "secrets",
            "dbcontainer",
            "header",
            "localowner"
          ],
          "detail": "Recover a usable key, open the database and check its selected-store and collection-bootstrap bindings."
        },
        {
          "title": "Finish required work / update current rows",
          "nodes": [
            "receiveq",
            "recvwork",
            "accepted",
            "verification",
            "reduce"
          ],
          "detail": "Handle required Changes and prerequisites, repeat unfinished checks, and bring current rows through the accepted history. Optional independent snapshots stay queued until the model is published. A healthy settled launch reads only the current state and required indexed work."
        },
        {
          "title": "Read complete values and editing context",
          "nodes": [
            "current",
            "view",
            "dict"
          ],
          "detail": "One consistent read captures all current bodies, editing frontiers, the view version and represented history position. Invalid rows or decoding metadata require reconstruction from healthy retained history."
        },
        {
          "title": "Publish the complete app model",
          "nodes": [
            "live",
            "search",
            "gate"
          ],
          "detail": "Construct all notes and search state. Recheck the owner, lifecycle, view version and accepted/current-row history positions before making the complete model visible. Search remains synchronous."
        }
      ],
      "edges": [
        "e91",
        "e92",
        "e97",
        "e121",
        "e122",
        "e123",
        "e55",
        "e17",
        "e23",
