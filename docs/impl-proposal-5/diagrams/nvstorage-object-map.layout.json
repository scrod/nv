      "id": "publish",
      "title": "Accepted bytes → repository",
      "short": "Publish",
      "description": "Publication copies exact locally durable objects into the repository through owned stages and checked installation.",
      "stages": [
        {
          "title": "Select accepted transport input",
          "nodes": [
            "accepted",
            "objects",
