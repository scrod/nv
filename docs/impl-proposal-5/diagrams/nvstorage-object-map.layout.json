        "e27",
        "e28",
        "e29",
        "e119",
        "e136",
        "e137"
      ]
    },
    {
      "id": "receive",
      "title": "Repository → accepted history",
      "short": "Receive",
      "description": "Discovery supplies possible incoming objects. Store their exact bytes, wait for required inputs, validate the complete history unit, and then accept it. Arrival order supplies no causal ordering.",
      "stages": [
        {
          "title": "Discover and read objects",
          "nodes": [
            "rkeys",
            "rchanges",
            "rinitial",
            "rgeneral",
            "recvwork",
            "rootowner"
          ],
          "detail": "Bounded reads from the owned repository capture exact candidate bytes."
        },
        {
          "title": "Keep bytes before accepting history",
          "nodes": [
            "objects",
            "receiveq"
          ],
          "detail": "Save incoming bytes and their ready, waiting or rejected status so receive work survives restart."
        },
        {
          "title": "Check the complete history unit",
          "nodes": [
            "decoded",
            "graph",
            "snapwork",
            "batch"
          ],
          "detail": "Resolve required inputs and check protection, history relationships and complete action groups."
        },
        {
          "title": "Accept history and update the model",
          "nodes": [
            "accepted",
            "pin",
            "reduce",
            "live"
          ],
          "detail": "Commit accepted history and the retained-history pin together. Check the current live generation before publishing prepared model changes."
        }
      ],
      "edges": [
        "e49",
        "e50",
        "e51",
        "e52",
        "e53",
        "e54",
        "e55",
        "e56",
        "e57",
